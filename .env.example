# GEMINI_API_KEY: Required for Gemini AI API calls (AI Core + JARVIS routes).
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for the contact form to deliver messages to the owner's inbox.
# Get a free key from https://resend.com/api-keys
RESEND_API_KEY="MY_RESEND_API_KEY"
